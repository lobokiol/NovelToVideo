def _drop_none_values(data: dict[str, Any]) -> dict[str, Any]:
    return {key: value for key, value in data.items() if value is not None}


class Text(BaseProvider):
    provider_key = PROVIDER_CONFIG["key"]
    provider_config = PROVIDER_CONFIG
    model_type = "text"

    async def generate(self, *, model_id: str | None = None, **kwargs: Any) -> Any:
        return await self.generate_text(model_id=model_id, **kwargs)

    async def generate_text(
        self,
        *,
        model_id: str | None = None,
        prompt: str | None = None,
        messages: list[dict[str, Any]] | None = None,
        **kwargs: Any,
    ) -> dict[str, Any]:
        if messages is None:
            if prompt is None:
                raise ProviderConfigurationError("必须提供 prompt 或 messages")
            messages = [{"role": "user", "content": prompt}]

        body = {
            "model": self.select_model_id(model_id),
            "messages": messages,
            **kwargs,
        }
        return await self.request_json("POST", "/chat/completions", json=body)


class Image(BaseProvider):
    provider_key = PROVIDER_CONFIG["key"]
    provider_config = PROVIDER_CONFIG
    model_type = "image"

    async def generate(self, *, model_id: str | None = None, **kwargs: Any) -> Any:
        return await self.generate_image(model_id=model_id, **kwargs)

    async def generate_image(
        self,
        *,
        model_id: str | None = None,
        prompt: str,
        size: str | None = "1024x1024",
        response_format: str | None = "b64_json",
        **kwargs: Any,
    ) -> dict[str, Any]:
        body = _drop_none_values(
            {
                "model": self.select_model_id(model_id),
                "prompt": prompt,
                "size": size,
                "response_format": response_format,
                **kwargs,
            }
        )
        return await self.request_json("POST", "/images/generations", json=body)


class Video(BaseProvider):
    provider_key = PROVIDER_CONFIG["key"]
    provider_config = PROVIDER_CONFIG
    model_type = "video"

    async def generate(self, *, model_id: str | None = None, **kwargs: Any) -> Any:
        return await self.generate_video(model_id=model_id, **kwargs)

    async def generate_video(
        self,
        *,
        model_id: str | None = None,
        prompt: str,
        input_reference: dict[str, Any] | None = None,
        seconds: str | int | None = None,
        size: str | None = None,
        **kwargs: Any,
    ) -> dict[str, Any]:
        body = _drop_none_values(
            {
                "model": self.select_model_id(model_id),
                "prompt": prompt,
                "input_reference": input_reference,
                "seconds": None if seconds is None else str(seconds),
                "size": size,
                **kwargs,
            }
        )
        return await self.request_json("POST", "/videos", json=body)


class TTS(BaseProvider):
    provider_key = PROVIDER_CONFIG["key"]
    provider_config = PROVIDER_CONFIG
    model_type = "tts"

    async def generate(self, *, model_id: str | None = None, **kwargs: Any) -> Any:
        return await self.generate_tts(model_id=model_id, **kwargs)

    async def generate_tts(
        self,
        *,
        model_id: str | None = None,
        text: str,
        voice: str = "alloy",
        response_format: str = "mp3",
        **kwargs: Any,
    ) -> bytes:
        body = {
            "model": self.select_model_id(model_id),
            "input": text,
            "voice": voice,
            "response_format": response_format,
            **kwargs,
        }
        return await self.request_bytes("POST", "/audio/speech", json=body)